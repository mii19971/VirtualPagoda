# Copy to .env.local (git-ignored) and fill in. Read only by server API routes
# (src/app/api/*+api.ts); never prefix with EXPO_PUBLIC_ or it ships in the app bundle.
GEMINI_API_KEY=
# Optional, defaults to gemini-3.6-flash.
GEMINI_MODEL=

# LocalTempleAPI base URL (public: shipped in the app bundle). On a phone/emulator use the
# dev machine's LAN IP, not localhost, e.g. http://192.168.1.10:5028. Defaults to http://localhost:5028.
EXPO_PUBLIC_API_URL=
